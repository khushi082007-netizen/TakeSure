# ---- TakeSure backend configuration (copy to .env; never commit .env) ----
APP_ENV=development                      # development | production | test
API_PREFIX=/api
KB_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000       # comma separated frontend origins

# Database: SQLite for quick local runs, PostgreSQL/Supabase for real deployments
DATABASE_URL=sqlite:///./takesure_dev.db
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Uploads (deleted immediately after OCR; purge safety-net after UPLOAD_TTL_SECONDS)
MAX_UPLOAD_MB=8
UPLOAD_TMP_DIR=/tmp/takesure_uploads
UPLOAD_TTL_SECONDS=900

# OCR / document processing — Docling is the primary engine
OCR_ENGINE=docling                       # docling | none
DOCLING_OCR_BACKEND=rapidocr             # rapidocr | easyocr | tesseract (engine Docling drives internally)
DOCLING_LANGUAGES=en                     # add 'hi' when the chosen backend supports Devanagari
OCR_TIMEOUT_SECONDS=120
# Offline / air-gapped: pre-download Docling models (`docling-tools models download`) and point here
# DOCLING_ARTIFACTS_PATH=/path/to/docling/models
# Developer-only fallback when Docling models cannot be fetched (always labelled "fallback" in API responses)
OCR_ALLOW_FALLBACK_ENGINE=false

# RapidFuzz thresholds (roadmap: >=85 accept, 70-85 confirm, <70 unrecognised)
MATCH_ACCEPT_THRESHOLD=85
MATCH_CONFIRM_THRESHOLD=70

# Grounded explainer — optional. With LLM_PROVIDER=none the deterministic KB explanation is used.
LLM_PROVIDER=none                        # none | anthropic | gemini | openai_compatible (Groq/Llama etc.)
LLM_API_KEY=
LLM_MODEL=                               # e.g. claude-haiku-4-5 | gemini-2.0-flash | llama-3.3-70b-versatile
LLM_BASE_URL=                            # only for openai_compatible, e.g. https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=20

RATE_LIMIT_PER_MINUTE=30
AYUSH_SURAKSHA_URL=https://ayushsuraksha.com
# PDF_DEVANAGARI_FONT=/usr/share/fonts/truetype/noto/NotoSansDevanagari-Regular.ttf

# ---- Frontend (frontend/.env.local) ----
# Browser-visible base URL of the FastAPI backend (no secrets ever go in NEXT_PUBLIC_* vars)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# ---- TinyFish (evidence curation: verify citations, draft rows from monographs, map products). Never on the verdict path. ----
# Get a key at https://agent.tinyfish.ai/api-keys (Search + Fetch are free; Agent runs use credits)
TINYFISH_API_KEY=
