# ---- TakeSure backend configuration (copy to .env; never commit .env) ----
APP_ENV=development                      # development | production | test
API_PREFIX=/api
KB_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database: SQLite for local runs (zero setup), PostgreSQL/Supabase for real deployments
DATABASE_URL=sqlite:///./takesure_dev.db
# DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Uploads (deleted immediately after OCR; purge safety-net after UPLOAD_TTL_SECONDS)
MAX_UPLOAD_MB=8
UPLOAD_TTL_SECONDS=900

# ---- Photo reading (OCR) ----
# auto        -> Groq vision when GROQ_API_KEY is set, otherwise local Tesseract
# tesseract   -> local Tesseract only (offline)
# groq_vision -> Groq multimodal model first, Tesseract as fallback
# none        -> photo reading off; manual entry only
OCR_ENGINE=auto
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe     (auto-detected when empty)
# TESSDATA_DIR=./tessdata                                         (auto-detected; contains eng + hin)
TESSERACT_LANGS=eng+hin
OCR_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct   # used only if your Groq account lists a vision model
OCR_TIMEOUT_SECONDS=90

# RapidFuzz thresholds (roadmap: >=85 accept, 70-85 confirm, <70 unrecognised)
MATCH_ACCEPT_THRESHOLD=85
MATCH_CONFIRM_THRESHOLD=70

# ---- AI explainer (optional) ----
# Easiest: paste a Groq key and leave the rest. The explainer AND vision OCR switch on automatically.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b          # any chat model your Groq account lists at /openai/v1/models
# Advanced: use another provider instead
# LLM_PROVIDER=anthropic | gemini | openai_compatible
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=25

RATE_LIMIT_PER_MINUTE=60
AYUSH_SURAKSHA_URL=https://ayushsuraksha.com
# PDF_DEVANAGARI_FONT=C:\Windows\Fonts\Nirmala.ttf
